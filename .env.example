# MEXC Futures API Anahtarları
# MEXC hesabınızdan ürettiğiniz API Key ve Secret Key'i buraya yapıştırın.
# Bu dosyayı .env olarak kaydedin (nokta ile başlayan gizli dosya).
# DİKKAT: Bu dosyayı asla GitHub'a yüklemeyin!

MEXC_API_KEY=buraya_api_keyinizi_yapistirin
MEXC_SECRET_KEY=buraya_secret_keyinizi_yapistirin

# Haber Analizi paneli için gerekli anahtar
# Haber kaynağı ücretsiz RSS akışlarından (Cointelegraph, Decrypt) geldiği için
# ayrı bir haber API anahtarı gerekmiyor — sadece Gemini anahtarı yeterli.
# Gemini: https://aistudio.google.com/apikey adresinden ücretsiz alın.
GEMINI_API_KEY=buraya_gemini_api_keyinizi_yapistirin
